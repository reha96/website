{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache/fetch-cache out && next build",
    "postbuild": "npx tsx lib/search-index.ts && npx tsx lib/sitemap.ts && find out -name '*.txt' ! -name 'robots.txt' -delete && npm run check && npm run audit:latex",
    "check": "npm run check:config && npm run check:links && npm run check:artifacts",
    "check:config": "npx tsx scripts/check-vercel-config.ts",
    "check:links": "npx tsx scripts/check-links.ts",
    "check:artifacts": "npx tsx scripts/check-artifacts.ts",
    "refresh:dates": "npx tsx scripts/refresh-dates.ts",
    "start": "next start",
    "lint": "next lint",
    "audit:latex": "npx tsx lib/audit-latex.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "^15.5.22",
    "hast-util-sanitize": "^5.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "sharp": "^0.35.3"
  }
}
